# YouTube BigQuery Pipeline — environment template
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit your real values.

# ─── Google Cloud ────────────────────────────────────────────────
# Your GCP project ID. The Cloud Function reads this at runtime via env var
# (see cloud_function/main.py line 32). Also used by setup/ scripts.
GCP_PROJECT=your-gcp-project-id

# BigQuery dataset name (default below matches setup/2_create_bigquery.sh)
BQ_DATASET=youtube_analytics

# Default deploy region for the Cloud Function + Scheduler job
GCP_REGION=us-central1

# ─── YouTube channel identity ───────────────────────────────────
# Your channel ID (UC-prefixed). Get from your channel URL.
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx

# Uploads playlist for your channel (always the channel ID with `UC` → `UU`).
UPLOADS_PLAYLIST_ID=UUxxxxxxxxxxxxxxxxxx

# ─── YouTube Data API ───────────────────────────────────────────
# API key from GCP Console → APIs & Services → Credentials → Create API key.
# Restrict it to YouTube Data API v3 only.
YOUTUBE_API_KEY=

# ─── Analytics API lookback ─────────────────────────────────────
# Days back from snapshot_date to query Analytics API.
# Analytics data has ~2-3 day latency, so default 3 is safe.
ANALYTICS_LOOKBACK_DAYS=3

# ─── Pipeline configuration ─────────────────────────────────────
# Duration threshold to classify a video as a short (seconds).
# YouTube's own threshold is currently 180s.
SHORTS_THRESHOLD_SECONDS=180

# Reporting API ingest (second Cloud Function, youtube-reporting-ingest)
REPORTING_ENABLED=false            # kill switch; required explicitly for the prod deploy
MAX_REPORTS_PER_RUN=30             # transactional loads per run (about 15 s each)
REPORTING_STALE_DAYS=4             # per-report-type freshness alert threshold
REPORTING_ARCHIVE_BUCKET=          # defaults to <GCP_PROJECT>-youtube-reporting-raw
