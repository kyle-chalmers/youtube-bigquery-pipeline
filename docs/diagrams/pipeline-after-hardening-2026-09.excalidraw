  {
   "type": "text",
   "id": "txn_t",
   "x": 52,
   "y": 850,
   "width": 396,
   "height": 230,
   "text": "-- one report = one transaction (partition_replacer.py)\nBEGIN TRANSACTION;\n  ASSERT work_table_rows > 0;\n  ASSERT exactly one report_date, the expected one;\n  ASSERT every row carries the configured channel_id;\n  ASSERT grain is unique;\n  ASSERT report_id not already loaded;\n  ASSERT no newer generation loaded for that day;\n  DELETE FROM reporting_x WHERE report_date = @day;\n  INSERT INTO reporting_x SELECT ... FROM work_table;\n  UPDATE ledger SET status = 'superseded' (old);\n  MERGE ledger ... status = 'loaded' (new);\nCOMMIT;   -- any failure: ROLLBACK, nothing changed",
   "originalText": "-- one report = one transaction (partition_replacer.py)\nBEGIN TRANSACTION;\n  ASSERT work_table_rows > 0;\n  ASSERT exactly one report_date, the expected one;\n  ASSERT every row carries the configured channel_id;\n  ASSERT grain is unique;\n  ASSERT report_id not already loaded;\n  ASSERT no newer generation loaded for that day;\n  DELETE FROM reporting_x WHERE report_date = @day;\n  INSERT INTO reporting_x SELECT ... FROM work_table;\n  UPDATE ledger SET status = 'superseded' (old);\n  MERGE ledger ... status = 'loaded' (new);\nCOMMIT;   -- any failure: ROLLBACK, nothing changed",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "strokeColor": "#c4ff00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
