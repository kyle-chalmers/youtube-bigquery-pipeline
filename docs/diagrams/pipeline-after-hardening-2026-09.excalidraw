  {
   "type": "text",
   "id": "alerts_t",
   "x": 980,
   "y": 870,
   "width": 340,
   "height": 150,
   "text": "youtube-analytics-failure   (existed; now also matches\n  a whole-pipeline crash, \"Pipeline failed\")\nyoutube-reporting-failure   load error, header-only\n  conflict, kill switch left off\nyoutube-reporting-stale     any report type older\n  than 4 days, computed from the ledger\nyoutube-scheduler-failure   run timed out or 5xx\n\nboth Reporting alerts fired in staging on a forced\nfailure and the emails arrived (Kyle, 2026-09-05)",
   "originalText": "youtube-analytics-failure   (existed; now also matches\n  a whole-pipeline crash, \"Pipeline failed\")\nyoutube-reporting-failure   load error, header-only\n  conflict, kill switch left off\nyoutube-reporting-stale     any report type older\n  than 4 days, computed from the ledger\nyoutube-scheduler-failure   run timed out or 5xx\n\nboth Reporting alerts fired in staging on a forced\nfailure and the emails arrived (Kyle, 2026-09-05)",
   "fontSize": 12,
