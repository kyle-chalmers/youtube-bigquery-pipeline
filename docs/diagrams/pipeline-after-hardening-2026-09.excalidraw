   "y": 850,
   "width": 376,
   "height": 100,
   "text": "-- reporting_ingest_ledger, one row per report file\nreport_type  channel_basic_a3   report_date  2026-08-31\nstatus       loaded             row_count    300\ncreate_time  2026-09-05 ...     gcs_uri      gs://.../<id>.csv.gz\n-- older 2026-09-02 generation of the same day: skipped_older;\n-- a generation replaced after loading shows superseded",
   "originalText": "-- reporting_ingest_ledger, one row per report file\nreport_type  channel_basic_a3   report_date  2026-08-31\nstatus       loaded             row_count    300\ncreate_time  2026-09-05 ...     gcs_uri      gs://.../<id>.csv.gz\n-- older 2026-09-02 generation of the same day: skipped_older;\n-- a generation replaced after loading shows superseded",
   "fontSize": 12,
